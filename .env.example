# Example environment variables. Copy to .env and fill in your own values.
# The code reads these with os.environ, so export them in your shell
# (e.g. `set -a; source .env; set +a`) before running.

# Used by "Automatic CV and Cover Letter with API" (OpenAI integration)
OPENAI_API_KEY=your-openai-api-key

# Flask session secret for the web UI (job_apply_ai/ui/app.py)
SECRET_KEY=change-me
